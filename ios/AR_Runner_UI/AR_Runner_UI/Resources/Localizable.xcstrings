        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "イヤホンはつながっていますが、頭の向きが届きません。AirPods Pro・AirPods(第3世代以降)・AirPods Max が必要です。なくても走れます"
          }
        }
      }
    },
