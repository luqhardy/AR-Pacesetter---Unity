    "safety.disclaimer.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The developers and providers accept no liability for accidents, injuries or damage that occur\nwhile using this app. You use it at your own judgment and risk."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本アプリの使用中に生じた事故・負傷・損害について、開発者および提供者は\n一切の責任を負いかねます。使用は利用者ご自身の判断と責任において行ってください。"
