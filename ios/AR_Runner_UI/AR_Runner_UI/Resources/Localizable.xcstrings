        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "走行に適した場所で"
          }
        }
      }
    },
    "safety.surroundings.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AR glasses overlay images on your view. Don't let them take your attention away from the ground, obstacles or other people."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ARグラスは視界に映像を重ねます。路面・障害物・他の利用者から注意をそらさないでください。"
          }
        }
      }
    },
