      }
    },
    "safety.place.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the app in a safe place such as an athletics track. Avoid roads with traffic, steps and stairs,\nand crowds."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "陸上トラックなど安全な場所でご使用ください。交通量のある道路、段差・階段の近く、\n人混みでの使用は避けてください。"
          }
        }
      }
    },
    "safety.place.title" : {
      "extractionState" : "manual",
      "localizations" : {
