      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The avatar 3 m ahead does not exist and may hide real obstacles.\nAlways put what is really in front of you first."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3m前方のアバターは実在しません。実際の障害物を覆い隠すことがあります。\n見えているものより、目の前の現実を優先してください。"
          }
        }
      }
    },
