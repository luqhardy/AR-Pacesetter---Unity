    "safety.health.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop using the app immediately if you feel dizzy or sick, or have eye strain or pain."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "めまい・吐き気・目の疲れ・痛みを感じた場合は、直ちに使用を中止してください。"
          }
        }
      }
    },
